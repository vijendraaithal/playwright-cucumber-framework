# =====================================================================
# ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to config/env/.env.<environment> (e.g. .env.dev, .env.qa)
# and fill in real values. Real .env files are gitignored — NEVER commit them.
#
# Locally      -> values loaded from config/env/.env.<TEST_ENV>
# CI (GitHub)  -> values injected via GitHub Encrypted Secrets
# CI (Azure)   -> values injected via Azure Key Vault + Pipeline Variable Groups
# =====================================================================

# Which environment profile is active (dev | qa | staging)
TEST_ENV=dev

# Application Under Test
BASE_URL=https://www.saucedemo.com

# --- Credentials ---
# Never hardcode actual passwords here. This file only documents
# the expected variable names for onboarding.
STANDARD_USER_USERNAME=standard_user
STANDARD_USER_PASSWORD=

LOCKED_USER_USERNAME=locked_out_user
LOCKED_USER_PASSWORD=

PROBLEM_USER_USERNAME=problem_user
PROBLEM_USER_PASSWORD=

# --- Execution Settings ---
HEADLESS=true
BROWSER=chromium
DEFAULT_TIMEOUT_MS=30000
RETRY_COUNT=1
WORKERS=4

# --- Logging ---
LOG_LEVEL=info

# --- Reporting ---
ALLURE_RESULTS_DIR=reports/allure-results

# =========================
# Dependencies
# =========================
node_modules/
.npm/
.pnp/
.pnp.js

# =========================
# Environment / Secrets
# NEVER commit real credentials. Only .env.example is tracked.
# =========================
config/env/.env
config/env/.env.*
!config/env/.env.example
*.pem
*.key

# =========================
# Playwright
# =========================
/test-results/
/playwright-report/
/playwright/.cache/
blob-report/

# =========================
# Allure Reports
# =========================
/reports/allure-results/
/reports/allure-report/
.allure/

# =========================
# Storage State (session cache — may contain auth tokens)
# =========================
**/storage-state/*.json
!**/storage-state/.gitkeep

# =========================
# Build output
# =========================
dist/
build/
*.tsbuildinfo

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*

# =========================
# IDE / OS
# =========================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.DS_Store
Thumbs.db

# =========================
# Misc
# =========================
*.tmp
coverage/
